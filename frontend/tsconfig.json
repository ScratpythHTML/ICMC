{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@api/*": ["./src/api/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@http/*": ["./src/http/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": [
    "**/*.tsx",
    "**/*.ts"
  ]
}
